# Local secrets and machine-specific config
config/local.secrets.json
*.secrets.json
.env
.env.*
**/.env
*.pem
**/*.pem
*.key
**/*.key
*.pfx
*.p12

# Build/temp
node_modules/
dist/
bin/
obj/
.vs/
.tmp/
temp/

# vault-search ONNX model cache (downloaded on first run, ~33MB)
scripts/vault-search/model-cache/

# Logs
*.log

# Secondary local Obsidian staging vault (contains plugin data with API keys).
# Canonical Brain SK vault is `_obsidian/`, which IS tracked.
Obsidian Vault/

# Any Obsidian plugin / workspace state (plugin auth tokens / API keys live here).
**/.obsidian/plugins/*/data.json
**/.obsidian/plugins/*/main.js
**/.obsidian/plugins/*/main.js.map
**/.obsidian/plugins/*/styles.css
**/.obsidian/plugins/*/manifest.json
**/.obsidian/plugins/*/.env
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/cache/**

# Obsidian Smart Connections / Smart Lookup vector cache (large, machine-specific)
**/.smart-env/
**/.smart-connections/

# Generic credential filename guards. Negations below keep templates,
# example files, and Markdown documentation committable.
**/*secret*
**/*password*
**/*token*

# --- Negations: legitimate files that must remain trackable ---
# Keep all Markdown documentation (e.g. OBSIDIAN_SECRET_HANDLING.md, knowledge notes).
!**/*.md
# Keep clearly-marked example/template files (no real values inside).
!**/*.example.*
!**/*.template.*
!**/*.sample.*

# === Machine-specific bulk / experimental tooling (regenerable, kept out of the public repo) ===
# IDE config
.idea/
# Redundant Obsidian zip (the canonical _obsidian/ vault is tracked instead)
_obsidian.zip
# Heavy / experimental tool trees (hundreds of MB of venvs, models, caches)
tools/brain-boost/
tools/brain-cognee/
tools/brain-graphiti/
tools/web-scrub/
# Git worktrees are working checkouts of OTHER repos — must never be committed
outputs/worktrees/
**/worktrees/
# Python / build caches that may appear inside synced stores
**/__pycache__/
**/.venv/
**/.cache/
# Large generated/compressed assets
*.gz

# === Cross-machine sync stores (_sync-stores/ added by the brain GitHub sync) ===
# Never let a copied store nest its own .git (would create a broken gitlink/submodule)
_sync-stores/**/.git/
# Keep knowledge files; drop any bulk that slips into a synced store
_sync-stores/**/node_modules/
_sync-stores/**/_archive/**/node_modules/

# === Secret-bearing memory notes — keep LOCAL only, never publish (placed after the
# !**/*.md negation so it wins). These store live API keys. ===
**/reference_stitch_api_key.md
**/*_api_key.md
**/*-api-key.md

# === Scraped third-party (Meta/Facebook) API reference docs ===
# Contain doc-example access tokens (CAA...) that trip secret scanners; not Falcon
# brain core. Keep local, exclude from the public repo.
outputs/datasets/Facebook documents/
